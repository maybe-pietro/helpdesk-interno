# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=helpdesk
MYSQL_USER=helpdesk_app
MYSQL_PASSWORD=change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Backend ---
PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- SMTP / notificacoes ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Helpdesk <no-reply@empresa.com>"
NOTIFICATIONS_ENABLED=false

# --- Frontend ---
# Use 127.0.0.1 instead of localhost if your machine resolves "localhost" slowly
# (IPv6 ::1 timing out before falling back to IPv4) — a common Windows symptom.
VITE_API_BASE_URL=http://127.0.0.1:4000/api
